# ── 필수 ──────────────────────────────────────────────────────────
# `openssl rand -hex 32` 로 생성해서 넣으세요. 절대 공개 저장소에 올리지 마세요.
SECRET_KEY=

# 컨테이너로 띄우는 경우 host 는 db 입니다.
DATABASE_URL=postgresql+psycopg://contacts:비밀번호를바꾸세요@db:5432/contacts
POSTGRES_USER=contacts
POSTGRES_PASSWORD=비밀번호를바꾸세요
POSTGRES_DB=contacts

# ── 관리자 최초 계정 ─────────────────────────────────────────────
ADMIN_USERNAME=admin
# 비워 두면 초기화 시 임의 비밀번호를 만들어 화면에 한 번 보여 줍니다.
ADMIN_PASSWORD=

# ── 동작 옵션 ────────────────────────────────────────────────────
# 목록에서 전화번호를 기본으로 가릴지 여부 (클릭하면 보임)
MASK_PHONES_BY_DEFAULT=true
# '최근 변경'으로 취급할 기간(일). 화면 음영은 쓰지 않지만 내부 판정에 쓰인다.
HIGHLIGHT_DAYS=45
UPLOAD_DIR=/app/data/uploads
MAX_UPLOAD_MB=50
SESSION_MAX_AGE=43200

# ── 로그인 보안 ──────────────────────────────────────────────────
# 2단계 인증(OTP 앱). 인터넷에 직접 열 때는 true 를 권장합니다.
# 켜면 각 사용자가 처음 로그인할 때 QR 등록 화면이 나옵니다.
REQUIRE_TOTP=false

# 로그인 실패 잠금: 같은 계정 또는 같은 IP 가 WINDOW 분 안에 LIMIT 번 틀리면
# 그 시간 동안 로그인을 막습니다.
LOGIN_FAIL_LIMIT=5
LOGIN_FAIL_WINDOW_MIN=10

# ── 백업 ─────────────────────────────────────────────────────────
# 매일 이 시각(0~23, KST)에 pg_dump 를 뜨고 지정한 일수만 보관합니다.
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14

# ── 주소와 포트 (Caddy) ──────────────────────────────────────────
# SITE_ADDRESS : 컨테이너 안에서 Caddy 가 응답할 주소
#   · 도메인을 적으면 HTTPS 인증서가 자동 발급됩니다.  예) contacts.example.com
#   · 도메인이 없으면 `:80` 그대로 두세요 (HTTP).
SITE_ADDRESS=:80

# HTTP_PORT / HTTPS_PORT : 서버(호스트)에서 열 포트
#   이미 다른 서비스가 80·443 을 쓰고 있으면 비어 있는 포트로 바꾸세요.
#   예) HTTP_PORT=8080 → http://<서버IP>:8080
#   확인 방법: sudo ss -lptn 'sport = :80'
HTTP_PORT=80
HTTPS_PORT=443

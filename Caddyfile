# SITE_ADDRESS 에 도메인을 넣으면 Let's Encrypt 인증서가 자동 발급됩니다.
#   SITE_ADDRESS=contacts.example.com
# 도메인이 없으면 포트만 지정하세요 (이 경우 HTTP이므로 사내망에서만 쓰세요).
#   SITE_ADDRESS=:8080

{$SITE_ADDRESS} {
	encode gzip

	# 개인정보 화면이므로 색인·프레임 삽입·캐시를 모두 차단한다.
	header {
		X-Robots-Tag "noindex, nofollow, noarchive"
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# 특정 IP에서만 열고 싶다면 아래 주석을 풀고 대역을 채우세요.
	# @notallowed not remote_ip 203.0.113.0/24 10.0.0.0/8
	# respond @notallowed "Forbidden" 403

	request_body {
		max_size 60MB
	}

	reverse_proxy app:8000
}
